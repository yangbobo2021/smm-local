  "obligations": {
    "qualification-c1": "无变化刷新保留ID/版本和连续资格",
    "qualification-c3": "失败/缺失中断资格，同配置同字节恢复建立新资格；多来源引用只沿当次从未失效资格，不借新来源恢复旧引用。",
    "source-lifecycle-c2": "排除和配置变更、来源移除使相应材料和引用退出；其他有效重叠来源继续保留当前版本。",
    "source-lifecycle-c3": "失败/缺失中断资格，同配置同字节恢复建立新资格；多来源引用只沿当次从未失效资格，不借新来源恢复旧引用。",
    "version-lifecycle-c1": "无变化刷新保留ID/版本和连续资格，编辑生成新版本，改回旧字节也不复活旧引用；采集时间明确不冒称实时文件。",
    "version-lifecycle-c2": "移动、删除"
  },
